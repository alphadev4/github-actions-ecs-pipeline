FROM node:22-alpine3.19 AS builder

WORKDIR /app


COPY .npmrc package*.json ./
RUN --mount=type=secret,id=node_auth_token \
    NODE_AUTH_TOKEN="$(cat /run/secrets/node_auth_token)" npm install --ignore-scripts

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_VENDOR_API_URL
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG NEXT_PUBLIC_AUTH0_DOMAIN
ARG NEXT_PUBLIC_AUTH0_CLIENT_ID
ARG NEXT_PUBLIC_AUTH0_SCOPE
ARG NEXT_PUBLIC_AUTH0_AUDIENCE
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG CSP_API_DOMAIN
ARG CSP_SCRIPT_SOURCES
ARG CSP_ANALYTICS_DOMAINS
ARG CSP_IMG_SOURCES
ARG CSP_CONNECT_SOURCES
ARG CSP_FRAME_SOURCES
ARG CSP_FONT_SOURCES
ARG CSP_STYLE_SOURCES
ARG CSP_MANIFEST_DOMAIN
ARG CSP_ENABLED
ARG NEXT_PUBLIC_PARTNER_INTEGRATION_ENABLED
ARG SENTRY_AUTH_TOKEN
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG SENTRY_DSN
ARG SENTRY_ENVIRONMENT
ARG SENTRY_TRACES_SAMPLE_RATE
ARG CSP_MEDIA_SOURCES

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_VENDOR_API_URL=$NEXT_PUBLIC_VENDOR_API_URL
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV NEXT_PUBLIC_AUTH0_DOMAIN=$NEXT_PUBLIC_AUTH0_DOMAIN
ENV NEXT_PUBLIC_AUTH0_CLIENT_ID=$NEXT_PUBLIC_AUTH0_CLIENT_ID
ENV NEXT_PUBLIC_AUTH0_SCOPE=$NEXT_PUBLIC_AUTH0_SCOPE
ENV NEXT_PUBLIC_AUTH0_AUDIENCE=$NEXT_PUBLIC_AUTH0_AUDIENCE
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY
ENV NEXT_PUBLIC_POSTHOG_HOST=$NEXT_PUBLIC_POSTHOG_HOST
ENV CSP_API_DOMAIN=$CSP_API_DOMAIN
ENV CSP_SCRIPT_SOURCES=$CSP_SCRIPT_SOURCES
ENV CSP_ANALYTICS_DOMAINS=$CSP_ANALYTICS_DOMAINS
ENV CSP_IMG_SOURCES=$CSP_IMG_SOURCES
ENV CSP_CONNECT_SOURCES=$CSP_CONNECT_SOURCES
ENV CSP_FRAME_SOURCES=$CSP_FRAME_SOURCES
ENV CSP_FONT_SOURCES=$CSP_FONT_SOURCES
ENV CSP_STYLE_SOURCES=$CSP_STYLE_SOURCES
ENV CSP_MANIFEST_DOMAIN=$CSP_MANIFEST_DOMAIN
ENV CSP_ENABLED=$CSP_ENABLED
ENV NEXT_PUBLIC_PARTNER_INTEGRATION_ENABLED=$NEXT_PUBLIC_PARTNER_INTEGRATION_ENABLED
# SENTRY_AUTH_TOKEN / ORG / PROJECT are used only by `next build` (source-map upload)
# and stay in this (discarded) builder stage — they never reach the runtime image.
ENV SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT
ENV SENTRY_DSN=$SENTRY_DSN
ENV SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT
ENV SENTRY_TRACES_SAMPLE_RATE=$SENTRY_TRACES_SAMPLE_RATE
# Browser SDK + CSP connect-src (ingest host) need the public DSN at build time.
ENV NEXT_PUBLIC_SENTRY_DSN=$SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT
ENV CSP_MEDIA_SOURCES=$CSP_MEDIA_SOURCES

COPY . .

RUN --mount=type=secret,id=stripe_secret_key \
    STRIPE_SECRET_KEY="$(cat /run/secrets/stripe_secret_key)" npm run build

# ---- Runtime image: Next.js standalone output (next.config.js: output "standalone") ----
FROM node:22-alpine3.19

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=80
ENV HOSTNAME=0.0.0.0

# Server-side Sentry reads these from the process env at runtime
# (shared/lib/sentry/config.ts), so they must live in the runtime image.
ARG SENTRY_DSN
ARG SENTRY_ENVIRONMENT
ARG SENTRY_TRACES_SAMPLE_RATE
ENV SENTRY_DSN=$SENTRY_DSN
ENV SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT
ENV SENTRY_TRACES_SAMPLE_RATE=$SENTRY_TRACES_SAMPLE_RATE

# The standalone build bundles the server and its production node_modules, so no
# reinstall is needed here. outputFileTracingRoot nests server.js under
# .next/standalone/<dir>/, so copy the whole tree — scripts/start-standalone.mjs
# locates server.js and links static/public at startup.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./.next/standalone
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/scripts/start-standalone.mjs ./scripts/start-standalone.mjs

EXPOSE 80

CMD ["node", "scripts/start-standalone.mjs"]
